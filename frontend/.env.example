# ─────────────────────────────────────────────────────────────────────────────
# BizPulse Frontend — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the BizPulse Django REST API.
# Local dev (with backend running):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (PythonAnywhere or your host):
#   NEXT_PUBLIC_API_URL=https://bizpulse.pythonanywhere.com
# NOTE: Do NOT include a trailing slash; the API client appends paths directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public URL of this frontend (used for Open Graph metadataBase).
# Set to your deployment URL at build time.
# Example: https://bizpulse.vercel.app  or  https://bizpulse.pythonanywhere.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
